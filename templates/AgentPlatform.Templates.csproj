<Project Sdk="Microsoft.NET.Sdk">

  <!-- Install: dotnet new install AgentPlatform.Templates. Use: dotnet new agent-platform -n Acme.Platform with the org option. -->

  <PropertyGroup>
    <PackageType>Template</PackageType>
    <PackageId>AgentPlatform.Templates</PackageId>
    <Version>0.2.0</Version>
    <Title>AgentPlatform templates</Title>
    <Description>dotnet new agent-platform: a governed GitHub Copilot agent platform for one organization, defined in F#, with CI that renders, plans and deploys it.</Description>
    <PackageLicenseExpression>MIT</PackageLicenseExpression>
    <PackageProjectUrl>https://github.com/garrettlondon1/agent-platform</PackageProjectUrl>
    <RepositoryUrl>https://github.com/garrettlondon1/agent-platform</RepositoryUrl>
    <RepositoryType>git</RepositoryType>    <PackageTags>dotnet-new;templates;github;copilot;agents;governance</PackageTags>
    <TargetFramework>net10.0</TargetFramework>
    <IncludeContentInPack>true</IncludeContentInPack>
    <IncludeBuildOutput>false</IncludeBuildOutput>
    <ContentTargetFolders>content</ContentTargetFolders>
    <NoDefaultExcludes>true</NoDefaultExcludes>
    <NoWarn>$(NoWarn);NU5128;NU5110;NU5111</NoWarn>
    <EnableDefaultItems>false</EnableDefaultItems>
  </PropertyGroup>

  <ItemGroup>
    <Content Include="agent-platform\**\*" Exclude="agent-platform\**\bin\**;agent-platform\**\obj\**" />
    <Compile Remove="**\*" />
  </ItemGroup>

</Project>
