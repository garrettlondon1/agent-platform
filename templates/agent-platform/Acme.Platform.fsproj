<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net10.0</TargetFramework>
    <AssemblyName>platform</AssemblyName>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <!-- The Copilot SDK marks managed settings and permission requests [Experimental]. -->
    <NoWarn>$(NoWarn);FS0057</NoWarn>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="Platform.fs" />
    <Compile Include="Program.fs" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="AgentPlatform" Version="0.1.0-framework" />
  </ItemGroup>

</Project>
