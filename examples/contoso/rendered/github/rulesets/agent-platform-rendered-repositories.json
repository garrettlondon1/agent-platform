{
  "name": "agent-platform-rendered-repositories",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    },
    "repository_name": {
      "include": [
        ".github-private",
        "copilot-plugins",
        "agentic-workflows",
        "platform-endpoints"
      ],
      "exclude": [],
      "protected": true
    }
  },
  "rules": [
    {
      "type": "update"
    },
    {
      "type": "deletion"
    },
    {
      "type": "non_fast_forward"
    }
  ],
  "bypass_actors": [
    {
      "actor_type": "Integration",
      "actor_id": 123456,
      "bypass_mode": "always"
    }
  ]
}
